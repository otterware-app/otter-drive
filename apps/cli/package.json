{
  "name": "otterdrive",
  "version": "0.2.0",
  "description": "The CLI for Otter Drive",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otterware-app/otter-drive.git",
    "directory": "apps/cli"
  },
  "homepage": "https://drive.otterware.app",
  "bugs": {
    "url": "https://github.com/otterware-app/otter-drive/issues"
  },
  "engines": {
    "node": "24.x"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "otterdrive": "dist/index.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rolldown -c && chmod +x dist/index.mjs",
    "check": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "15.0.0",
    "mime-types": "3.0.2",
    "open": "11.0.0",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@otterware/contracts": "workspace:*",
    "@types/mime-types": "3.0.1",
    "@types/node": "24.13.3",
    "rolldown": "1.1.5",
    "tsx": "4.23.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
